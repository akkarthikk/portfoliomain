
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Management</title>

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: "Poppins", sans-serif;
            background: #f5f7fb;
            color: #1f2937;
        }

        /* ================= HEADER ================= */

        .topbar {
            height: 72px;
            background: #ffffff;
            border-bottom: 1px solid #e5e7eb;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 40px;

            position: sticky;
            top: 0;
            z-index: 10;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-icon {
            width: 40px;
            height: 40px;

            border-radius: 11px;

            background: #2563eb;
            color: white;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 18px;
        }

        .brand h2 {
            font-size: 17px;
            font-weight: 600;
        }

        .brand span {
            display: block;
            color: #9ca3af;
            font-size: 10px;
            margin-top: 1px;
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .back-btn {
            text-decoration: none;
            color: #374151;

            background: #f3f4f6;

            padding: 9px 15px;
            border-radius: 9px;

            font-size: 12px;
            font-weight: 500;

            transition: 0.2s;
        }

        .back-btn:hover {
            background: #e5e7eb;
        }

        .admin-badge {
            background: #eff6ff;
            color: #2563eb;

            padding: 8px 13px;
            border-radius: 20px;

            font-size: 11px;
            font-weight: 600;
        }

        /* ================= MAIN ================= */

        .main {
            max-width: 1450px;
            margin: auto;
            padding: 35px 40px 60px;
        }

        .page-heading {
            margin-bottom: 28px;
        }

        .page-heading h1 {
            font-size: 28px;
            font-weight: 600;
            color: #111827;
        }

        .page-heading p {
            margin-top: 5px;
            color: #6b7280;
            font-size: 13px;
        }

        /* ================= STAT CARDS ================= */

        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;

            margin-bottom: 30px;
        }

        .stat-card {
            background: white;

            border: 1px solid #e5e7eb;
            border-radius: 15px;

            padding: 20px;

            display: flex;
            align-items: center;
            gap: 15px;
        }

        .stat-icon {
            width: 48px;
            height: 48px;

            border-radius: 12px;

            background: #eff6ff;
            color: #2563eb;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 21px;
        }

        .stat-card h3 {
            font-size: 21px;
            font-weight: 600;
            color: #111827;
        }

        .stat-card p {
            font-size: 11px;
            color: #9ca3af;
        }

        /* ================= SECTION ================= */

        .section {
            background: white;

            border: 1px solid #e5e7eb;
            border-radius: 17px;

            margin-bottom: 30px;

            overflow: hidden;
        }

        .section-header {
            padding: 22px 25px;

            border-bottom: 1px solid #e5e7eb;

            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .section-title {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .section-icon {
            width: 38px;
            height: 38px;

            border-radius: 10px;

            background: #eff6ff;
            color: #2563eb;

            display: flex;
            align-items: center;
            justify-content: center;
        }

        .section-title h2 {
            font-size: 16px;
            font-weight: 600;
        }

        .section-title p {
            font-size: 10px;
            color: #9ca3af;
            margin-top: 2px;
        }

        .count {
            background: #f3f4f6;
            color: #6b7280;

            padding: 6px 10px;

            border-radius: 20px;

            font-size: 10px;
            font-weight: 600;
        }

        /* ================= TABLE ================= */

        .table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;

            min-width: 850px;
        }

        th {
            text-align: left;

            background: #f9fafb;

            color: #6b7280;

            font-size: 10px;
            font-weight: 600;

            text-transform: uppercase;
            letter-spacing: 0.4px;

            padding: 14px 18px;

            border-bottom: 1px solid #e5e7eb;
        }

        td {
            padding: 16px 18px;

            font-size: 12px;

            border-bottom: 1px solid #f1f5f9;

            vertical-align: middle;
        }

        tbody tr {
            transition: 0.15s;
        }

        tbody tr:hover {
            background: #fafafa;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        /* ================= USER ================= */

        .user-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .avatar {
            width: 34px;
            height: 34px;

            border-radius: 50%;

            background: #dbeafe;
            color: #2563eb;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 12px;
            font-weight: 600;
        }

        .user-name {
            font-weight: 600;
            color: #111827;
        }

        .email {
            color: #6b7280;
            font-size: 11px;
        }

        .password {
            font-family: monospace;

            background: #f3f4f6;

            padding: 5px 8px;

            border-radius: 6px;

            font-size: 10px;
        }

        .security {
            max-width: 180px;
            color: #6b7280;
            font-size: 11px;
        }

        /* ================= POSTS ================= */

        .post-title {
            font-weight: 600;
            color: #111827;

            max-width: 220px;
        }

        .post-content {
            max-width: 330px;

            color: #6b7280;

            line-height: 1.5;

            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .post-author {
            font-weight: 600;
        }

        .date {
            color: #6b7280;
            white-space: nowrap;
            font-size: 11px;
        }

        /* ================= DELETE ================= */

        .delete-btn {
            width: 34px;
            height: 34px;

            display: inline-flex;
            align-items: center;
            justify-content: center;

            border-radius: 9px;

            background: #fef2f2;
            color: #dc2626;

            transition: 0.2s;

            text-decoration: none;
        }

        .delete-btn:hover {
            background: #fee2e2;
            transform: translateY(-1px);
        }

        .delete-btn svg {
            width: 15px;
            height: 15px;
        }

        /* ================= EMPTY ================= */

        .empty {
            padding: 35px;
            text-align: center;

            color: #9ca3af;

            font-size: 13px;
        }

        /* ================= FOOTER ================= */

        .footer {
            text-align: center;

            color: #9ca3af;

            font-size: 11px;

            margin-top: 10px;
        }

        /* ================= RESPONSIVE ================= */

        @media (max-width: 900px) {

            .topbar {
                padding: 0 20px;
            }

            .main {
                padding: 25px 20px 50px;
            }

            .stats {
                grid-template-columns: 1fr;
            }

            .admin-badge {
                display: none;
            }
        }

        @media (max-width: 600px) {

            .topbar {
                height: auto;
                padding: 15px 18px;
            }

            .brand h2 {
                font-size: 15px;
            }

            .back-btn {
                padding: 8px 10px;
            }

            .main {
                padding: 22px 14px 40px;
            }

            .page-heading h1 {
                font-size: 23px;
            }

            .section-header {
                padding: 18px;
            }

            td,
            th {
                padding: 13px;
            }
        }
    </style>
</head>

<body>

<!-- ================= TOP BAR ================= -->

<header class="topbar">

    <div class="brand">

        <div class="brand-icon">
            ⚙
        </div>

        <div>
            <h2>Admin Panel</h2>
            <span>Blog Management</span>
        </div>

    </div>

    <div class="top-actions">

        <span class="admin-badge">
            Administrator
        </span>

        <a href="/admin" class="back-btn">
            ← Dashboard
        </a>

    </div>

</header>


<!-- ================= MAIN ================= -->

<main class="main">

    <div class="page-heading">

        <h1>Management Center</h1>

        <p>
            Manage registered users and blog content from one place.
        </p>

    </div>


    <!-- ================= STATS ================= -->

    <div class="stats">

        <div class="stat-card">

            <div class="stat-icon">
                👥
            </div>

            <div>
                <h3><%= users.length %></h3>
                <p>Registered Users</p>
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon">
                📝
            </div>

            <div>
                <h3><%= posts.length %></h3>
                <p>Total Blog Posts</p>
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon">
                🛡️
            </div>

            <div>
                <h3>Active</h3>
                <p>Admin System Status</p>
            </div>

        </div>

    </div>


    <!-- ================= USERS ================= -->

    <section class="section">

        <div class="section-header">

            <div class="section-title">

                <div class="section-icon">
                    👥
                </div>

                <div>
                    <h2>Registered Users</h2>
                    <p>Manage user accounts and information</p>
                </div>

            </div>

            <span class="count">
                <%= users.length %> Users
            </span>

        </div>


        <% if (users.length > 0) { %>

        <div class="table-wrapper">

            <table>

                <thead>

                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Password</th>
                        <th>Security Question</th>
                        <th>Security Answer</th>
                        <th>Action</th>
                    </tr>

                </thead>

                <tbody>

                    <% users.forEach(user => { %>

                    <tr>

                        <td>

                            <div class="user-info">

                                <div class="avatar">
                                    <%= user.name ? user.name.charAt(0).toUpperCase() : "U" %>
                                </div>

                                <div>
                                    <div class="user-name">
                                        <%= user.name %>
                                    </div>
                                </div>

                            </div>

                        </td>

                        <td>
                            <span class="email">
                                <%= user.email %>
                            </span>
                        </td>

                        <td>
                            <span class="password">
                                <%= user.password %>
                            </span>
                        </td>

                        <td>
                            <div class="security">
                                <%= user.security_question || "Not provided" %>
                            </div>
                        </td>

                        <td>
                            <div class="security">
                                <%= user.security_answer || "Not provided" %>
                            </div>
                        </td>

                        <td>

                            <a
                                class="delete-btn"
                                href="/deleteuser/<%= user.email %>"
                                onclick="return confirm('Are you sure you want to delete this user?')"
                                title="Delete user"
                            >

                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    fill="currentColor"
                                    viewBox="0 0 16 16"
                                >
                                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                    <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                </svg>

                            </a>

                        </td>

                    </tr>

                    <% }); %>

                </tbody>

            </table>

        </div>

        <% } else { %>

            <div class="empty">
                No registered users found.
            </div>

        <% } %>

    </section>


    <!-- ================= POSTS ================= -->

    <section class="section">

        <div class="section-header">

            <div class="section-title">

                <div class="section-icon">
                    📝
                </div>

                <div>
                    <h2>Blog Posts</h2>
                    <p>Review and manage published content</p>
                </div>

            </div>

            <span class="count">
                <%= posts.length %> Posts
            </span>

        </div>


        <% if (posts.length > 0) { %>

        <div class="table-wrapper">

            <table>

                <thead>

                    <tr>
                        <th>Author</th>
                        <th>Email</th>
                        <th>Title</th>
                        <th>Post Content</th>
                        <th>Last Updated</th>
                        <th>Action</th>
                    </tr>

                </thead>

                <tbody>

                    <% posts.forEach(post => { %>

                    <tr>

                        <td>
                            <span class="post-author">
                                <%= post.name %>
                            </span>
                        </td>

                        <td>
                            <span class="email">
                                <%= post.email %>
                            </span>
                        </td>

                        <td>
                            <div class="post-title">
                                <%= post.title %>
                            </div>
                        </td>

                        <td>
                            <div class="post-content">
                                <%= post.posts %>
                            </div>
                        </td>

                        <td>
                            <span class="date">
                                <%= new Date(post.date).toLocaleString("en-IN", {
                                    timeZone: "Asia/Kolkata",
                                    day: "2-digit",
                                    month: "short",
                                    year: "numeric",
                                    hour: "2-digit",
                                    minute: "2-digit",
                                    hour12: true
                                }) %>
                            </span>
                        </td>

                        <td>

                            <a
                                class="delete-btn"
                                href="/admin/deletepost/<%= post._id %>"
                                onclick="return confirm('Are you sure you want to delete this post?')"
                                title="Delete post"
                            >

                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    fill="currentColor"
                                    viewBox="0 0 16 16"
                                >
                                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                    <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 1-1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                </svg>

                            </a>

                        </td>

                    </tr>

                    <% }); %>

                </tbody>

            </table>

        </div>

        <% } else { %>

            <div class="empty">
                No blog posts found.
            </div>

        <% } %>

    </section>


    <div class="footer">
        Admin Management Center • Blog Application
    </div>

</main>

</body>
</html>
